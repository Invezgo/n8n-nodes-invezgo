{
  "name": "n8n-nodes-invezgo",
  "version": "0.2.0",
  "description": "n8n community node for the Invezgo API: Indonesian stock market (IDX) data, broker summary, shareholders, financials, screener, watchlist and more.",
  "license": "MIT",
  "homepage": "https://github.com/Invezgo/n8n-nodes-invezgo#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "invezgo",
    "idx",
    "bei",
    "saham",
    "indonesia",
    "stock"
  ],
  "author": {
    "name": "Invezgo",
    "email": "admin@invezgo.com",
    "url": "https://invezgo.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Invezgo/n8n-nodes-invezgo.git"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "node scripts/check.mjs"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/InvezgoApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Invezgo/Invezgo.node.js",
      "dist/nodes/InvezgoTrigger/InvezgoTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/Invezgo/n8n-nodes-invezgo/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
